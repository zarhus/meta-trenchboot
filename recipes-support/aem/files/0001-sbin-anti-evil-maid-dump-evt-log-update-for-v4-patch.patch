From d98ac2c1ee1263e26adaaf8df9818e1cff6877eb Mon Sep 17 00:00:00 2001
From: Sergii Dmytruk <sergii.dmytruk@3mdeb.com>
Date: Fri, 24 Jul 2026 01:12:41 +0300
Subject: [PATCH] sbin/anti-evil-maid-dump-evt-log: update for v4 patchset

Signed-off-by: Sergii Dmytruk <sergii.dmytruk@3mdeb.com>
---
 sbin/anti-evil-maid-dump-evt-log | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/sbin/anti-evil-maid-dump-evt-log b/sbin/anti-evil-maid-dump-evt-log
index d2a3aaf..03d7cd3 100755
--- a/sbin/anti-evil-maid-dump-evt-log
+++ b/sbin/anti-evil-maid-dump-evt-log
@@ -3,9 +3,9 @@ set -euo pipefail -o errtrace
 
 source anti-evil-maid-lib
 
-range=$(xl dmesg | grep "SLAUNCH: reserving event log" | sed "s#.*(\(.*\))#\1#")
-base=$(($(echo "$range" | cut -d " " -f 1)))
-size=$(($(echo "$range" | cut -d " " -f 3) - base))
+range=$(xl dmesg | grep "SLAUNCH: reserving event log" | sed 's#.*\[\(.*\))#\1#')
+base=$(($(echo "$range" | cut -d ", " -f 1)))
+size=$(($(echo "$range" | cut -d ", " -f 2) - base))
 
 printf "Found event log at %#x, size %#x (%d) bytes\n" $base $size $size
 
-- 
2.55.0

