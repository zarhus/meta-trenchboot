From 974f687bbb24beffcf23bc8e9451c9ccfa6bd108 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Iwanicki?= <michal.iwanicki@3mdeb.com>
Date: Wed, 16 Sep 2026 16:30:33 +0200
Subject: [PATCH] head.S: list family 1Ah in the SOC flags
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The SOC flag structure names the CPU families and models the image is
built for, as CPUID leaf 1 EAX with the low byte cleared. The list ends
at family 19h. The Gigabyte MZ33-AR1 carries an EPYC 9015, family 1Ah
model 02h, CPUID 0x00B00F21, and its ASP answers DRTM_CMD_LAUNCH with
DRTM_LAUNCH_ERROR for an image whose header, signature and key token
otherwise match AMD's signing tool output. The list is the one field
left that does not describe that CPU.

The structure has to keep eight entries. GRUB reads skl_info_offset and
bootloader_data_offset from fixed offsets 0x42 and 0x44, and boot.h
declares the same layout, so a ninth entry would move both fields.
Family 1Ah model 00h replaces family 17h model 60h, the oldest entry.

Upstream-Status: Pending
Signed-off-by: Michał Iwanicki <michal.iwanicki@3mdeb.com>
---
 head.S | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/head.S b/head.S
index 93a25c7..180e55e 100644
--- a/head.S
+++ b/head.S
@@ -54,9 +54,14 @@ soc_flag:
 	 * This structure isn't described in the spec, but it is assumed to be a
 	 * number of entries, followed by family and model of supported CPUs, in
 	 * form of EAX of CPUID leaf 1 with stepping set to 0.
+	 *
+	 * The structure has a fixed size of eight entries: GRUB and boot.h both
+	 * locate skl_info and bootloader_data at offsets 0x42 and 0x44, right
+	 * after it. Family 1Ah model 00h (EPYC 9005) takes the slot of family
+	 * 17h model 60h.
 	 */
 	.long	0x00000008
-	.long	0x00860f00
+	.long	0x00b00f00
 	.long	0x00a50f00
 	.long	0x00a40f00
 	.long	0x00a70f00
-- 
2.55.0

