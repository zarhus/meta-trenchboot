From 3bc4def26f342374b9b76b5d0d3dd85408f2749d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Iwanicki?= <michal.iwanicki@3mdeb.com>
Date: Tue, 15 Sep 2026 09:31:23 +0200
Subject: [PATCH 1/3] pci.c: use type 1 accesses when MMIO config space lies
 above 4G
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

pci_init() kept only the low 32 bits of MSR C001_0058. On a platform
that places the MMIO configuration space above 4 GiB the enable bit is
set and bits 31:20 are zero, so SKL selected the MMIO accessor with a
base of 0 and every configuration read returned low physical memory.

On a Gigabyte MZ33-AR1 (EPYC 9015, firmware R19_F13) the MSR reads
0x00003FFB00000021, which puts the configuration space at
0x3FFB00000000. discover_psp() enumerated device IDs that match no
hardware and get_psp_bar_addr() returned 0, so the PSP was never found.
GRUB, which uses 0xCF8/0xCFC on the same platform, finds the PSP and
its BAR.

Read the whole 64-bit MSR value, derive the region size from BusRange,
and use the MMIO accessor only when the region lies below 4 GiB. That
is the range SKL can address: the 32-bit build runs without paging and
the 64-bit build identity-maps the first 4 GiB. Otherwise use type 1
accesses, and print a note so the chosen path shows up in the log.

Fixes: https://github.com/TrenchBoot/trenchboot-issues/issues/81
Signed-off-by: Michał Iwanicki <michal.iwanicki@3mdeb.com>
---
 pci.c | 32 +++++++++++++++++++++++++++-----
 1 file changed, 27 insertions(+), 5 deletions(-)

diff --git a/pci.c b/pci.c
index 0b33bf21a398..4d33e799f0a0 100644
--- a/pci.c
+++ b/pci.c
@@ -23,6 +23,7 @@
 #include <errno-base.h>
 #include <boot.h>
 #include <pci.h>
+#include <printk.h>
 
 int (*pci_read)(unsigned int seg, unsigned int bus,
                 unsigned int devfn, int reg, int len, u32 *value);
@@ -193,20 +194,41 @@ u32 pci_locate(unsigned int bus, unsigned int devfn)
     return pci_cap_ptr;
 }
 
+/* MSR C001_0058, MMIO configuration space base address (AMD64 APM vol. 2). */
+#define MSR_MMIO_CFG_BASE_ADDR      0xc0010058
+#define MMIO_CFG_BASE_ENABLE        (1ULL << 0)
+#define MMIO_CFG_BASE_BUS_RANGE(v)  (((v) >> 2) & 0xf)
+#define MMIO_CFG_BASE_ADDR_MASK     0x000ffffffff00000ULL   /* bits 51:20 */
+
 void pci_init(void)
 {
     u32 eax, edx;
-
-    asm volatile("rdmsr" : "=a"(eax), "=d"(edx) : "c"(0xc0010058));
-
-    if ( eax & 1 )  /* MMIO configuration space is enabled */
+    u64 msr, base, size;
+
+    asm volatile("rdmsr" : "=a"(eax), "=d"(edx) : "c"(MSR_MMIO_CFG_BASE_ADDR));
+    msr = ((u64)edx << 32) | eax;
+
+    base = msr & MMIO_CFG_BASE_ADDR_MASK;
+    /* One 1 MiB segment per bus, 2^BusRange buses. */
+    size = 1ULL << (20 + MMIO_CFG_BASE_BUS_RANGE(msr));
+
+    /*
+     * SKL can address only the first 4 GiB of physical memory: the 32-bit
+     * build runs without paging and the 64-bit build identity-maps 4 GiB.
+     * Use type 1 accesses when the MMIO configuration space lies outside
+     * that range.
+     */
+    if ( (msr & MMIO_CFG_BASE_ENABLE) && base + size <= 0x100000000ULL )
     {
-        mmio_base_addr = (eax & 0xfff00000);
+        mmio_base_addr = (u32)base;
         pci_read = &pci_mmio_read;
         pci_write = &pci_mmio_write;
     }
     else
     {
+        if ( msr & MMIO_CFG_BASE_ENABLE )
+            print("PCI: MMIO configuration space above 4G, using type 1 accesses\n");
+
         pci_read = &pci_conf1_read;
         pci_write = &pci_conf1_write;
     }
-- 
