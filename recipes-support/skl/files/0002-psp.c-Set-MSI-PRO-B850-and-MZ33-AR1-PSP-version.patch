From 5baf5700f33fab30a0e4c94af64d9e3f86908461 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Iwanicki?= <michal.iwanicki@3mdeb.com>
Date: Fri, 20 Feb 2026 10:36:31 +0100
Subject: [PATCH 2/2] psp.c: Set MSI PRO B850 and MZ33-AR1 PSP version
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

MSI PRO B850 (1022:15C7) - change from PSP_NONE to PSP_V3
MZ33-AR1 (1022:156E) - add device and set to ASP (and expand
                       psp_version_t enum)

Upstream-Status: Pending
Signed-off-by: Michał Iwanicki <michal.iwanicki@3mdeb.com>
---
 psp.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/psp.c b/psp.c
index 8cefa9ebbc2f..a395e9d18e07 100644
--- a/psp.c
+++ b/psp.c
@@ -54,7 +54,8 @@ typedef enum {
     PSP_NONE = 0,
     PSP_V1,
     PSP_V2,
-    PSP_V3
+    PSP_V3,
+    ASP,
 } psp_version_t;
 
 struct pci_psp_device {
@@ -71,7 +72,8 @@ const struct pci_psp_device psp_devs_list[] = {
     {0x1022, 0x15DF, PSP_V3},
     {0x1022, 0x1649, PSP_V2},
     {0x1022, 0x14CA, PSP_V3},
-    {0x1022, 0x15C7, PSP_NONE}
+    {0x1022, 0x15C7, PSP_V3},
+    {0x1022, 0x156E, ASP},
 };
 
 static bool init_drtm_interface(u64 base_addr, psp_version_t psp_version);
@@ -226,6 +228,7 @@ static bool init_drtm_interface(u64 base_addr, psp_version_t psp_version)
     switch(psp_version) {
     case PSP_V3:
     case PSP_V2:
+    case ASP:
         g_psp_drtm.c2pmsg_72 = (volatile u32 *)(u32)(base + 0x10a20);
         g_psp_drtm.c2pmsg_93 = (volatile u32 *)(u32)(base + 0x10a74);
         g_psp_drtm.c2pmsg_94 = (volatile u32 *)(u32)(base + 0x10a78);
-- 
2.52.0

