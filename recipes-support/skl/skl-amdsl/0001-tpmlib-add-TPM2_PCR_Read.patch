From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Iwanicki?= <michal.iwanicki@3mdeb.com>
Date: Wed, 16 Sep 2026 16:30:33 +0200
Subject: [PATCH 1/8] tpmlib: add TPM2_PCR_Read
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

tpm2_pcr_read() reads one bank of one PCR and returns the digest and
its length. tpm_pcr_read() wraps it for TPM 2.0 and rejects TPM 1.2.
The response parser skips pcrUpdateCounter and pcrSelectionOut, and
reports -ENOENT when the TPM returns no digest, which is what an
inactive bank produces.

Upstream-Status: Inappropriate [debug]
Signed-off-by: Michał Iwanicki <michal.iwanicki@3mdeb.com>
---
 tpmlib/tpm.c            |  11 +++++
 tpmlib/tpm.h            |   2 +
 tpmlib/tpm2.h           |   7 +++
 tpmlib/tpm2_cmds.c      | 107 ++++++++++++++++++++++++++++++++++++++++
 tpmlib/tpm2_constants.h |   1 +
 5 files changed, 128 insertions(+)

diff --git a/tpmlib/tpm.c b/tpmlib/tpm.c
index e4a5d91..addc209 100644
--- a/tpmlib/tpm.c
+++ b/tpmlib/tpm.c
@@ -163,6 +163,17 @@ int tpm_get_pcr_banks(struct tpm *t, u16 *algs, u32 *count)
 	return tpm2_get_pcr_banks(t, algs, count);
 }
 
+int tpm_pcr_read(struct tpm *t, u32 pcr, u16 algo, u8 *digest, u16 *size)
+{
+	if (t->buff == NULL)
+		return -EINVAL;
+
+	if (t->family != TPM20)
+		return -EINVAL;
+
+	return tpm2_pcr_read(t, pcr, algo, digest, size);
+}
+
 void free_tpm(struct tpm *t)
 {
 	tpm_relinquish_locality(t);
diff --git a/tpmlib/tpm.h b/tpmlib/tpm.h
index ca75a83..7cc9667 100644
--- a/tpmlib/tpm.h
+++ b/tpmlib/tpm.h
@@ -57,5 +57,7 @@ extern void tpm_relinquish_locality(struct tpm *t);
 extern int tpm_extend_pcr(struct tpm *t, u32 pcr, u16 algo,
 		u8 *digest);
 extern int tpm_get_pcr_banks(struct tpm *t, u16 *algs, u32 *count);
+extern int tpm_pcr_read(struct tpm *t, u32 pcr, u16 algo,
+		u8 *digest, u16 *size);
 extern void free_tpm(struct tpm *t);
 #endif
diff --git a/tpmlib/tpm2.h b/tpmlib/tpm2.h
index 1d1a3cd..eabaacd 100644
--- a/tpmlib/tpm2.h
+++ b/tpmlib/tpm2.h
@@ -96,4 +96,11 @@ int tpm2_extend_pcr(struct tpm *t, u32 pcr,
  */
 int tpm2_get_pcr_banks(struct tpm *t, u16 *algs, u32 *count);
 
+/*
+ * Read one bank of one PCR. On success *size holds the digest length and
+ * digest[] the value. Returns the TPM response code on a TPM error, a
+ * negative errno on a transport error.
+ */
+int tpm2_pcr_read(struct tpm *t, u32 pcr, u16 alg, u8 *digest, u16 *size);
+
 #endif
diff --git a/tpmlib/tpm2_cmds.c b/tpmlib/tpm2_cmds.c
index d76adc7..9f9978a 100644
--- a/tpmlib/tpm2_cmds.c
+++ b/tpmlib/tpm2_cmds.c
@@ -268,3 +268,110 @@ free:
 out:
 	return ret;
 }
+
+int tpm2_pcr_read(struct tpm *t, u32 pcr, u16 alg, u8 *digest, u16 *size)
+{
+	struct tpmbuff *b = t->buff;
+	struct tpm2_cmd cmd;
+	struct tpm_header *hdr;
+	u8 *p, *end;
+	u32 count, i, sel_count;
+	u16 dsize;
+	int ret = 0;
+
+	if (b == NULL || pcr > 23 || digest == NULL || size == NULL)
+		return -EINVAL;
+
+	ret = tpm2_alloc_cmd(b, &cmd, TPM_ST_NO_SESSIONS, TPM_CC_PCR_READ);
+	if (ret < 0)
+		goto out;
+
+	/* TPML_PCR_SELECTION: count, TPMS_PCR_SELECTION{hash, sizeofSelect, pcrSelect[3]} */
+	cmd.params = (u8 *)tpmb_put(b, sizeof(u32) + sizeof(u16) + 1 + 3);
+	if (cmd.params == NULL) {
+		ret = -ENOMEM;
+		goto free;
+	}
+
+	p = cmd.params;
+	*(u32 *)p = cpu_to_be32(1);
+	p += sizeof(u32);
+	*(u16 *)p = cpu_to_be16(alg);
+	p += sizeof(u16);
+	*p++ = 3;
+	p[0] = p[1] = p[2] = 0;
+	p[pcr / 8] = 1 << (pcr % 8);
+
+	cmd.header->size = cpu_to_be32(tpmb_size(b));
+
+	if (t->ops.send(b) != tpmb_size(b)) {
+		ret = -EAGAIN;
+		goto free;
+	}
+
+	/* Reset buffer for receive, recv() fills in the header and grows the buffer */
+	tpmb_trim(b, tpmb_size(b));
+	hdr = (struct tpm_header *)b->head;
+	tpmb_put(b, sizeof(struct tpm_header));
+
+	if (t->ops.recv(t->family, b) != tpmb_size(b)) {
+		ret = -EAGAIN;
+		goto free;
+	}
+
+	/* recv() converted the header to CPU endianness */
+	if (hdr->code != 0) {
+		ret = (int)hdr->code;
+		goto free;
+	}
+
+	/*
+	 * Response: pcrUpdateCounter, TPML_PCR_SELECTION pcrSelectionOut,
+	 * TPML_DIGEST pcrValues.
+	 */
+	p = b->head + sizeof(struct tpm_header);
+	end = b->head + hdr->size;
+
+	if (end - p < sizeof(u32) + sizeof(u32)) {
+		ret = -EIO;
+		goto free;
+	}
+	p += sizeof(u32);				/* pcrUpdateCounter */
+	sel_count = be32_to_cpu(*(u32 *)p);
+	p += sizeof(u32);
+	for (i = 0; i < sel_count; i++) {
+		if (end - p < sizeof(u16) + 1) {
+			ret = -EIO;
+			goto free;
+		}
+		p += sizeof(u16);			/* hash */
+		p += 1 + p[0];				/* sizeofSelect, pcrSelect[] */
+	}
+
+	if (end - p < sizeof(u32) + sizeof(u16)) {
+		ret = -EIO;
+		goto free;
+	}
+	count = be32_to_cpu(*(u32 *)p);
+	p += sizeof(u32);
+	if (count != 1) {
+		/* The bank is not active or the PCR is not implemented */
+		ret = -ENOENT;
+		goto free;
+	}
+
+	dsize = be16_to_cpu(*(u16 *)p);
+	p += sizeof(u16);
+	if (dsize > *size || end - p < dsize) {
+		ret = -EIO;
+		goto free;
+	}
+
+	memcpy(digest, p, dsize);
+	*size = dsize;
+
+free:
+	tpmb_free(b);
+out:
+	return ret;
+}
diff --git a/tpmlib/tpm2_constants.h b/tpmlib/tpm2_constants.h
index 2893cde..805c5c1 100644
--- a/tpmlib/tpm2_constants.h
+++ b/tpmlib/tpm2_constants.h
@@ -59,6 +59,7 @@
 
 /* Table 12  Definition of (UINT32) TPM_CC Constants (Numeric Order) <IN/OUT, S> */
 #define TPM_CC_GET_CAPABILITY        _AT(u32, 0x0000017A)
+#define TPM_CC_PCR_READ              _AT(u32, 0x0000017E)
 #define TPM_CC_PCR_EXTEND            _AT(u32, 0x00000182)
 
 /* Table 22  Definition of (UINT32) TPM_CAP Constants <IN/OUT, S> */
